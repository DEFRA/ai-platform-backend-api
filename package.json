{
  "name": "ai-platform-backend-api",
  "version": "0.0.0",
  "description": "ai-platform-backend-api",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "cross-env AWS_EMF_ENVIRONMENT=Local NODE_ENV=development npm run server:watch | pino-pretty",
    "dev:debug": "cross-env AWS_EMF_ENVIRONMENT=Local NODE_ENV=development npm run server:debug | pino-pretty",
    "dev:nowatch": "cross-env AWS_EMF_ENVIRONMENT=Local NODE_ENV=development node --env-file-if-exists=.env ./src | pino-pretty",
    "docker:dev": "npm run dev",
    "format": "prettier --write \"**/*.{cjs,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{cjs,js,json,md}\"",
    "git:pre-commit-hook": "npm run security-audit && npm run format:check && npm run lint && npm test",
    "lint": "eslint --cache --cache-strategy content \"**/*.{cjs,js}\"",
    "lint:fix": "npm run lint -- --fix",
    "security-audit": "npm audit --audit-level=critical",
    "server:debug": "node --watch-path=./src --inspect-brk=0.0.0.0 --env-file-if-exists=.env ./src",
    "server:watch": "node --watch-path=./src --inspect=0.0.0.0 --env-file-if-exists=.env ./src",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "start": "NODE_ENV=production node . --env-file-if-exists=.env",
    "test": "TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@aws-sdk/credential-providers": "3.1146.0",
    "@azure/identity": "4.13.3",
    "@azure/keyvault-secrets": "4.11.2",
    "@defra/cdp-auditing": "0.6.2",
    "@defra/cdp-metrics": "0.6.1",
    "@defra/hapi-auth-oidc": "0.6.0",
    "@defra/hapi-secure-context": "0.4.1",
    "@defra/hapi-tracing": "1.30.1",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/boom": "10.0.1",
    "@hapi/hapi": "21.4.10",
    "@octokit/auth-app": "8.3.1",
    "aws4": "1.13.2",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "4.0.0",
    "joi": "18.2.9",
    "mongo-locks": "3.2.0",
    "mongodb": "7.7.0",
    "octokit": "5.0.5",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "neostandard": "0.13.0",
    "nock": "15.0.1",
    "npm-run-all": "4.1.5",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.9",
    "vitest": "5.0.3",
    "vitest-fetch-mock": "0.4.5",
    "vitest-mongodb": "1.0.3"
  }
}
